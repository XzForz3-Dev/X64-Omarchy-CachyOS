* {
    /* Glassmorphism Color Palette */
    bg-base:        rgba(10, 15, 25, 0.95);
    bg-alt:         rgba(30, 41, 59, 0.85);
    bg-selected:    rgba(255, 255, 255, 0.15);
    b-color:        rgba(255, 255, 255, 0.1);
    b-focus:        rgba(255, 255, 255, 0.4);
    t-color:        #e2e8f0;
    t-muted:        #94a3b8;

    font: "Inter 12";
    background-color: transparent;
    text-color: @t-color;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    width: 600px;
    background-color: @bg-base;
    border-radius: 20px;
    border: 1px;
    border-color: @b-color;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    spacing: 15px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px;
    spacing: 10px;
    border: 1px;
    border-color: @b-color;
    children: [ prompt, entry ];
}

prompt {
    text-color: @t-muted;
    font: "JetBrainsMono Nerd Font 12";
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @t-muted;
    text-color: @t-color;
}

listview {
    background-color: transparent;
    columns: 2;
    lines: 8;
    spacing: 10px;
    cycle: false;
    dynamic: true;
    scrollbar: true;
}

scrollbar {
    background-color: @bg-alt;
    handle-color: @b-focus;
    handle-width: 4px;
    border-radius: 4px;
    margin: 0px 0px 0px 5px;
}

element {
    background-color: transparent;
    padding: 10px;
    border-radius: 12px;
    spacing: 15px;
    border: 1px;
    border-color: transparent;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1px;
    border-color: @b-focus;
    text-color: #ffffff;
}

element alternate.normal {
    background-color: transparent;
}
