{
    "custom/dock-firefox": {
        "format": "󰈹",
        "on-click": "pkill wofi; firefox",
        "tooltip": false
    },
    "custom/dock-alacritty": {
        "format": "",
        "on-click": "pkill wofi; alacritty",
        "tooltip": false
    },
    "custom/dock-dolphin": {
        "format": "",
        "on-click": "pkill wofi; dolphin",
        "tooltip": false
    },
    "custom/dock-x64-projects": {
        "format": "󰖟",
        "on-click": "pkill wofi; firefox --new-window https://x64studios.com/proyectos",
        "tooltip": false
    },
    "group/dock": {
        "orientation": "inherit",
        "modules": [
            "custom/dock-firefox", "custom/dock-alacritty", "custom/dock-dolphin", "custom/dock-x64-projects"
        ]
    }
}
