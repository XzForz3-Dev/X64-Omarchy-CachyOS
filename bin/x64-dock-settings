#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# x64-dock-settings: Interfaz Gráfica Premium para el Dock de X64 Studios con Autodescubrimiento

import sys
import os
import glob
import json
import subprocess

try:
    from PyQt6.QtWidgets import (QApplication, QWidget, QVBoxLayout, QHBoxLayout, 
                                 QCheckBox, QPushButton, QLabel, QMessageBox, QLineEdit,
                                 QScrollArea, QFrame)
    from PyQt6.QtCore import Qt
except ImportError:
    print("Error: PyQt6 no está instalado. Ejecuta: sudo pacman -S python-pyqt6")
    sys.exit(1)

DOCK_CONF = os.path.expanduser("~/.config/waybar-x64/modules/dock.json")

# Diseño CSS/QSS Cyberpunk de X64
QSS = """
