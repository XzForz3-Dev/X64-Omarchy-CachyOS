def get_installed_apps():
    """ Escanea el sistema operativo en busca de archivos .desktop """
    apps = []
    # Siempre incluir el acceso web de X64 Studios
    apps.append({
        "id": "x64-projects", 
        "name": "Proyectos X64 Studios (Web)", 
        "icon": "firefox", 
        "cmd": "firefox --new-window https://x64studios.com/proyectos"
    })
    
    paths = ['/usr/share/applications', os.path.expanduser('~/.local/share/applications')]
    seen_execs = set()
    
    for path in paths:
        if os.path.exists(path):
            for file in glob.glob(os.path.join(path, '*.desktop')):
                try:
                    with open(file, 'r', encoding='utf-8', errors='ignore') as f:
                        name = None
                        exec_cmd = None
                        icon = "application-x-executable"
                        
                        for line in f:
                            if line.startswith('Name=') and not name:
                                name = line.split('=', 1)[1].strip()
                            elif line.startswith('Exec=') and not exec_cmd:
                                raw_cmd = line.split('=', 1)[1].strip()
                                exec_cmd = raw_cmd.split(' %')[0].strip()
                            elif line.startswith('Icon='):
                                icon = line.split('=', 1)[1].strip()
                                
                        if name and exec_cmd:
                            # Evitar duplicados exactos
                            if exec_cmd not in seen_execs:
                                seen_execs.add(exec_cmd)
                                app_id = os.path.basename(file).replace('.desktop', '').replace(' ', '_').lower()
                                apps.append({
                                    "id": app_id,
                                    "name": name,
                                    "icon": icon,
                                    "cmd": exec_cmd
                                })
                except Exception:
                    pass
                    
    # Ordenar alfabéticamente ignorando mayúsculas, pero dejar x64-projects primero
    x64_app = apps.pop(0)
    apps.sort(key=lambda x: x['name'].lower())
    apps.insert(0, x64_app)
    
    return apps

class DockAppWidget(QWidget):
    def __init__(self, app_id, name, icon, cmd, checked=False):
        super().__init__()
        self.app_id = app_id
        
        layout = QHBoxLayout()
        layout.setContentsMargins(10, 5, 10, 5)
        
        # Drag Handle
        handle = QLabel("☰")
        handle.setStyleSheet("color: #64748b; font-size: 18px; font-weight: bold;")
        handle.setCursor(Qt.CursorShape.OpenHandCursor)
        layout.addWidget(handle)
        
        # Checkbox
        self.checkbox = QCheckBox()
        self.checkbox.setChecked(checked)
        self.checkbox.setCursor(Qt.CursorShape.PointingHandCursor)
        layout.addWidget(self.checkbox)
        
        # Icon Preview
        self.icon_preview = QLabel()
        self.icon_preview.setObjectName("icon_preview")
        self.icon_preview.setFixedSize(36, 36)
        self.icon_preview.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.icon_preview)
        
        # Name, Command, and Icon path
        v_layout = QVBoxLayout()
        v_layout.setSpacing(2)
        
        self.name_input = QLineEdit()
        self.name_input.setObjectName("name_input")
        self.name_input.setText(name)
        v_layout.addWidget(self.name_input)
        
        # Icon input + Browse
        icon_layout = QHBoxLayout()
        icon_layout.setSpacing(5)
        self.icon_input = QLineEdit()
        self.icon_input.setObjectName("icon_input")
        self.icon_input.setText(icon)
        self.icon_input.setPlaceholderText("Nombre del ícono (ej. firefox) o ruta SVG/PNG")
        self.icon_input.textChanged.connect(self.update_preview)
        icon_layout.addWidget(self.icon_input)
        
        self.browse_btn = QPushButton("📁")
        self.browse_btn.setObjectName("browse_btn")
        self.browse_btn.setFixedSize(30, 30)
        self.browse_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.browse_btn.clicked.connect(self.browse_icon)
        icon_layout.addWidget(self.browse_btn)
        
        v_layout.addLayout(icon_layout)
        
        self.cmd_input = QLineEdit()
        self.cmd_input.setObjectName("cmd_input")
        self.cmd_input.setText(cmd)
        v_layout.addWidget(self.cmd_input)
        
        layout.addLayout(v_layout)
        layout.setStretch(3, 1) # stretch the v_layout
        
        self.setLayout(layout)
        self.update_preview()
        
    def browse_icon(self):
        file_name, _ = QFileDialog.getOpenFileName(self, "Seleccionar Ícono", "", "Imágenes (*.png *.svg *.jpg)")
        if file_name:
            self.icon_input.setText(file_name)
            
    def update_preview(self):
        icon_str = self.icon_input.text()
        pixmap = None
        if os.path.isabs(icon_str) and os.path.exists(icon_str):
            pixmap = QPixmap(icon_str)
        else:
            qicon = QIcon.fromTheme(icon_str)
            if qicon.isNull():
                qicon = QIcon.fromTheme("application-x-executable")
            if not qicon.isNull():
                pixmap = qicon.pixmap(32, 32)
                
        if pixmap and not pixmap.isNull():
            # Scale smoothly
            pixmap = pixmap.scaled(32, 32, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            self.icon_preview.setPixmap(pixmap)
        else:
            self.icon_preview.setText("?")
        
    def get_data(self):
        return {
            "id": self.app_id,
            "name": self.name_input.text(),
            "icon": self.icon_input.text(),
            "cmd": self.cmd_input.text(),
            "checked": self.checkbox.isChecked()
        }

class DockSettings(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Gestor Visual de Íconos - X64 Studios")
        self.resize(600, 750)
        self.setStyleSheet(QSS)
        # Forzar tema de íconos para que QIcon.fromTheme funcione mejor en algunos entornos
        QIcon.setThemeName("Papirus") 
        
        self.apps = get_installed_apps()
        self.init_ui()
        self.load_current()

    def init_ui(self):
        main_layout = QVBoxLayout()
        main_layout.setContentsMargins(30, 30, 30, 30)
        main_layout.setSpacing(15)

        title = QLabel("Lanzadores X64 (Imágenes Reales)")
        title.setObjectName("title")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        main_layout.addWidget(title)

        subtitle = QLabel("Extrae íconos reales de tu sistema. Habilita, cambia rutas o arrastra (☰) para reordenar tu dock:")
        subtitle.setWordWrap(True)
        subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)
        subtitle.setStyleSheet("color: #94a3b8; font-size: 13px;")
        main_layout.addWidget(subtitle)

        # Buscador en tiempo real
        self.search_input = QLineEdit()
        self.search_input.setPlaceholderText("🔍 Buscar aplicación...")
        self.search_input.textChanged.connect(self.filter_apps)
        main_layout.addWidget(self.search_input)

        # Lista interactiva
        self.list_widget = QListWidget()
        self.list_widget.setDragDropMode(QAbstractItemView.DragDropMode.InternalMove)
        self.list_widget.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.list_widget.setVerticalScrollMode(QAbstractItemView.ScrollMode.ScrollPerPixel)
        main_layout.addWidget(self.list_widget)
        
        # Llenar la lista inicial
        for app in self.apps:
            self.add_app_to_list(app["id"], app["name"], app["icon"], app["cmd"], False)
            
        # Botón para añadir lanzador custom
        btn_add = QPushButton("➕ Añadir Lanzador Personalizado")
        btn_add.setObjectName("add_btn")
        btn_add.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_add.clicked.connect(self.add_custom_launcher)
        main_layout.addWidget(btn_add)

        btn_save = QPushButton("Guardar y Aplicar")
        btn_save.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_save.clicked.connect(self.save_and_apply)
        
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()
        btn_layout.addWidget(btn_save)
        btn_layout.addStretch()
        
        main_layout.addLayout(btn_layout)
        self.setLayout(main_layout)
        
    def add_app_to_list(self, app_id, name, icon, cmd, checked, insert_at_top=False):
        item = QListWidgetItem()
        widget = DockAppWidget(app_id, name, icon, cmd, checked)
        
        item.setSizeHint(QSize(400, 100))
        
        if insert_at_top:
            self.list_widget.insertItem(0, item)
        else:
            self.list_widget.addItem(item)
            
        self.list_widget.setItemWidget(item, widget)
        return widget

    def add_custom_launcher(self):
        uid = str(uuid.uuid4())[:8]
        custom_id = f"custom-app-{uid}"
        self.add_app_to_list(custom_id, "Lanzador Personalizado", "application-x-executable", "bash ~/script.sh", True, insert_at_top=True)
        self.search_input.setText("")
        self.list_widget.scrollToTop()

    def filter_apps(self, text):
        query = text.lower()
        for i in range(self.list_widget.count()):
            item = self.list_widget.item(i)
            widget = self.list_widget.itemWidget(item)
            if widget:
                item.setHidden(query not in f"{widget.name_input.text()} {widget.cmd_input.text()}".lower())

    def load_current(self):
        if not os.path.exists(DOCK_CONF):
            defaults = ["firefox", "alacritty", "dolphin", "x64-projects"]
            for i in range(self.list_widget.count()):
                item = self.list_widget.item(i)
                widget = self.list_widget.itemWidget(item)
                if widget and any(d in widget.app_id.lower() for d in defaults):
                    widget.checkbox.setChecked(True)
            return
            
        try:
            with open(DOCK_CONF, "r", encoding='utf-8') as f:
                data = json.load(f)
                
            group_mods = data.get("group/dock", {}).get("modules", [])
            
            widget_dict = {}
            for i in range(self.list_widget.count()):
                item = self.list_widget.item(i)
                w = self.list_widget.itemWidget(item)
                if w:
                    widget_dict[w.app_id] = w
            
            self.list_widget.clear()
            
            for mod in group_mods:
                # Soporta viejos custom/dock-* y nuevos image#dock-*
                mod_app_id = mod.replace("custom/dock-", "").replace("image#dock-", "")
                
                if mod_app_id in widget_dict:
                    w = widget_dict.pop(mod_app_id)
                    if mod in data:
                        custom_cmd = data[mod].get("on-click", "").replace("pkill wofi; ", "")
                        w.cmd_input.setText(custom_cmd)
                        
                        source = data[mod].get("x64-icon-source")
                        if source:
                            w.icon_input.setText(source)
                            w.update_preview()
                            
                    self.add_app_to_list(w.app_id, w.name_input.text(), w.icon_input.text(), w.cmd_input.text(), True)
                else:
                    if mod in data:
                        c_cmd = data[mod].get("on-click", "").replace("pkill wofi; ", "")
                        c_name = mod_app_id.replace("custom-app-", "").replace("_", " ").title()
                        c_icon = data[mod].get("x64-icon-source", "application-x-executable")
                        if "custom" in c_name.lower(): c_name = "Lanzador Personalizado"
                        self.add_app_to_list(mod_app_id, c_name, c_icon, c_cmd, True)

            for w in widget_dict.values():
                self.add_app_to_list(w.app_id, w.name_input.text(), w.icon_input.text(), w.cmd_input.text(), False)
                
        except Exception as e:
            print(f"Error al cargar la configuración existente: {e}")

    def save_and_apply(self):
        data = {}
        module_names = []
        
        os.makedirs(ICONS_DIR, exist_ok=True)
        
        for i in range(self.list_widget.count()):
            item = self.list_widget.item(i)
            widget = self.list_widget.itemWidget(item)
            
            if widget and widget.checkbox.isChecked():
                w_data = widget.get_data()
                mod_name = f"image#dock-{w_data['id']}"
                module_names.append(mod_name)
                
                # Extraer y guardar imagen PNG real
                icon_str = w_data['icon']
                icon_path = os.path.join(ICONS_DIR, f"{w_data['id']}.png")
                
                if os.path.isabs(icon_str) and os.path.exists(icon_str):
                    QIcon(icon_str).pixmap(64, 64).save(icon_path, "PNG")
                else:
                    qicon = QIcon.fromTheme(icon_str)
                    if qicon.isNull():
                        qicon = QIcon.fromTheme("application-x-executable")
                    qicon.pixmap(64, 64).save(icon_path, "PNG")
                
                data[mod_name] = {
                    "path": icon_path,
                    "size": 32,
                    "on-click": f"pkill wofi; {w_data['cmd']}",
                    "x64-icon-source": icon_str, # Metadato privado para que el script lo recupere luego
                    "tooltip": False
                }
                
        data["group/dock"] = {
            "orientation": "inherit",
            "modules": module_names
        }
        
        os.makedirs(os.path.dirname(DOCK_CONF), exist_ok=True)
        try:
            DOCK_CSS = os.path.expanduser("~/.config/waybar-x64/modules/dock-styles.css")
        
            with open(DOCK_CONF, "w", encoding='utf-8') as f:
                json.dump(data, f, indent=4, ensure_ascii=False)
                
            # Generar CSS dinámico. Para Waybar image, el ID es image-dock-*
            if module_names:
                css_selectors = ",\n".join([f"#{mod.replace('image#', 'image-')}" for mod in module_names])
                css_content = f"""{css_selectors} {{
    padding: 0 10px;
    margin: 2px 4px;
    background: transparent;
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}}

{",\n".join([f"#{mod.replace('image#', 'image-')}:hover" for mod in module_names])} {{
    background-color: rgba(0, 212, 255, 0.15);
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
}}
"""
            else:
                css_content = ""
                
            with open(DOCK_CSS, "w", encoding='utf-8') as f:
                f.write(css_content)
                
            subprocess.run(["killall", "-SIGUSR2", "waybar"], stderr=subprocess.DEVNULL)
            
            msg = QMessageBox(self)
            msg.setWindowTitle("Éxito")
            msg.setText(f"Se han anclado {len(module_names)} aplicaciones al Dock.\\nSe usaron íconos reales del sistema (PNG/SVG).")
            msg.setStyleSheet("background-color: #0f172a; color: #00d4ff;")
            msg.exec()
            
            self.close()
        except Exception as e:
            err = QMessageBox(self)
            err.setWindowTitle("Error")
            err.setText(f"No se pudo guardar la configuración:\\n{e}")
            err.setStyleSheet("background-color: #0f172a; color: #ef4444;")
            err.exec()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = DockSettings()
    window.show()
    sys.exit(app.exec())
