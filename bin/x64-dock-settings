                                 QListWidget, QListWidgetItem, QAbstractItemView, QFrame, QFileDialog)
    from PyQt6.QtCore import Qt, QSize
    from PyQt6.QtGui import QIcon, QPixmap
except ImportError:
    print("Error: PyQt6 no está instalado. Ejecuta: sudo pacman -S python-pyqt6")
    sys.exit(1)

DOCK_CONF = os.path.expanduser("~/.config/waybar-x64/modules/dock.json")
ICONS_DIR = os.path.expanduser("~/.config/waybar-x64/modules/icons")

# Diseño CSS/QSS Cyberpunk de X64
