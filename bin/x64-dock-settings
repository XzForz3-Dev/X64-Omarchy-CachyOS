#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# x64-dock-settings: Interfaz Gráfica Premium para el Dock de X64 Studios con Autodescubrimiento Avanzado e Íconos Reales

import sys
import os
import glob
import json
import subprocess
import uuid
import shutil

try:
    from PyQt6.QtWidgets import (QApplication, QWidget, QVBoxLayout, QHBoxLayout, 
