    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Inter", "Roboto", sans-serif;
    font-size: 14px;
}
QLabel#title {
    font-size: 24px;
    font-weight: 800;
    color: #00d4ff;
    padding-bottom: 5px;
}
QLineEdit {
    background-color: #1e293b;
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 10px;
    font-size: 15px;
    color: #00d4ff;
    margin-bottom: 10px;
}
QLineEdit:focus {
    border: 2px solid #00d4ff;
}
QScrollArea {
    border: 1px solid #334155;
    border-radius: 8px;
    background-color: #1e293b;
}
QScrollBar:vertical {
    border: none;
    background: #0f172a;
    width: 10px;
    border-radius: 5px;
}
