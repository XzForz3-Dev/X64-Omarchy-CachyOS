#!/bin/bash

# omarchy:summary=Finalize Omarchy user setup (runtime tweaks /etc/skel can't do)
# omarchy:group=finalize
# omarchy:examples=omarchy finalize user | omarchy finalize user --force

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omarchy finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and omarchy-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/omarchy/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run omarchy-finalize-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/omarchy"
mkdir -p "$state_dir"

if omarchy-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
export OMARCHY_SETUP_CONTEXT="${OMARCHY_SETUP_CONTEXT:-runtime}"
export PATH="$OMARCHY_PATH/bin:$PATH"

if (( first_install )); then
  export OMARCHY_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${OMARCHY_INSTALL_LOG_FILE:-} && -f $OMARCHY_INSTALL/helpers/logging.sh ]]; then
  source "$OMARCHY_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because OMARCHY_PATH may
# point at a dev checkout (omarchy dev link) where the target differs.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills
ln -sfn "$OMARCHY_PATH/default/omarchy-skill" ~/.agents/skills/omarchy
ln -sfn "$OMARCHY_PATH/default/omarchy-skill" ~/.claude/skills/omarchy
ln -sfn "$OMARCHY_PATH/default/omarchy-skill" ~/.codex/skills/omarchy
ln -sfn "$OMARCHY_PATH/default/omarchy-skill" ~/.pi/agent/skills/omarchy

# Actualizar los directorios al idioma actual del sistema (borrando caché previa para forzar la recreación física)
rm -f ~/.config/user-dirs.dirs
xdg-user-dirs-update

# Cargar las variables oficiales XDG_*
if [[ -f ~/.config/user-dirs.dirs ]]; then
  source ~/.config/user-dirs.dirs
else
  # Fallbacks
  XDG_DOWNLOAD_DIR="$HOME/Downloads"
  XDG_PICTURES_DIR="$HOME/Pictures"
  XDG_VIDEOS_DIR="$HOME/Videos"
  XDG_DOCUMENTS_DIR="$HOME/Documents"
  XDG_MUSIC_DIR="$HOME/Music"
fi

xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"

# Determinar el nombre de la carpeta de proyectos según el idioma
PROJECTS_DIR="$HOME/Projects"
if [[ "${LANG:-}" == es_* ]]; then
  PROJECTS_DIR="$HOME/Proyectos"
fi

# Limpieza inteligente de carpetas genéricas residuales (en inglés y español)
for dir in Desktop Downloads Templates Public Documents Music Pictures Videos Projects \
           Escritorio Descargas Plantillas Público Documentos Música Imágenes Vídeos Proyectos; do
  dir_path="$HOME/$dir"
  if [[ -d "$dir_path" ]]; then
    # Si la carpeta NO está mapeada en user-dirs.dirs, ni es la carpeta oficial de Proyectos, es un residuo duplicado
    if ! grep -q "\"$dir_path\"" ~/.config/user-dirs.dirs 2>/dev/null && [[ "$dir_path" != "$PROJECTS_DIR" ]]; then
      rmdir "$dir_path" 2>/dev/null || true
    fi
  fi
done

mkdir -p ~/.config/gtk-3.0
touch ~/.config/gtk-3.0/bookmarks

# Marcadores dinámicos que respetan el idioma oficial
for b in "$XDG_DOWNLOAD_DIR" "$PROJECTS_DIR" "$XDG_PICTURES_DIR" "$XDG_VIDEOS_DIR" "$XDG_DOCUMENTS_DIR" "$XDG_MUSIC_DIR"; do
  if [[ -n "$b" && "$b" != "$HOME" ]]; then
    mkdir -p "$b"
    b_name="$(basename "$b")"
    bookmark="file://$b $b_name"
    grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
  fi
done

if [[ -f "$OMARCHY_INSTALL/user/all.sh" ]]; then
  source "$OMARCHY_INSTALL/user/all.sh"
fi

omarchy-refresh-applications
env -u BROWSER xdg-settings set default-web-browser chromium.desktop 2>/dev/null || true
xdg-mime default HEY.desktop x-scheme-handler/mailto 2>/dev/null || true

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$OMARCHY_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
  
  # Inyectar script nativo de Plasma para establecer el fondo "zero-delay"
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *"KDE"* || -d "$HOME/.config/kde.org" || -d "$HOME/.kde4" || -d "$HOME/.local/share/plasma" || -z "${XDG_CURRENT_DESKTOP:-}" ]]; then
    PLASMA_UPDATES_DIR="$HOME/.local/share/plasma/shells/org.kde.plasma.desktop/updates"
    mkdir -p "$PLASMA_UPDATES_DIR" 2>/dev/null || true
    cat <<'EOF' > "$PLASMA_UPDATES_DIR/01-x64-studios-wallpaper.js"
var allDesktops = desktops();
for (var i = 0; i < allDesktops.length; i++) {
    var d = allDesktops[i];
    d.wallpaperPlugin = "org.kde.image";
    d.currentConfigGroup = Array("Wallpaper", "org.kde.image", "General");
    d.writeConfig("Image", "file:///usr/share/omarchy/themes/x64-studios-default/backgrounds/default.png");
}
EOF
  fi
fi

omarchy-done mark finalize-user
echo "User finalization complete."
