#!/bin/bash

# omarchy:summary=Display the X64 LIOS logo in the terminal using the theme accent color.

clear

# Obtener el color accent del tema activo (hex como #7aa2f7)
hex=$(omarchy-theme-color accent 2>/dev/null)

if [[ -n $hex ]]; then
  # Convertir hex (#RRGGBB) a RGB para ANSI truecolor
  hex="${hex#\#}"
  r=$(( 16#${hex:0:2} ))
  g=$(( 16#${hex:2:2} ))
  b=$(( 16#${hex:4:2} ))
  echo -e "\033[38;2;${r};${g};${b}m"
else
  # Fallback: rosa neón si no hay tema
  echo -e "\033[38;5;198m"
fi

cat <$OMARCHY_PATH/logo.txt
echo -e "\033[0m"
echo
