#!/usr/bin/env python3
import sys
import os
import json
import shutil
import colorsys

def hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip('#')
    if len(hex_color) == 3:
        hex_color = ''.join([c*2 for c in hex_color])
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(rgb):
    return '#{:02x}{:02x}{:02x}'.format(int(rgb[0]), int(rgb[1]), int(rgb[2]))

def adjust_lightness(hex_color, amount):
    r, g, b = hex_to_rgb(hex_color)
    h, l, s = colorsys.rgb_to_hls(r/255.0, g/255.0, b/255.0)
    l = max(0, min(1, l + amount))
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return rgb_to_hex((r*255, g*255, b*255))

def save_theme(name, accent, foreground, background):
    home = os.path.expanduser("~")
    theme_dir = os.path.join(home, "Temas", name)
    bg_dir = os.path.join(home, "Fondos", name)
    
    os.makedirs(theme_dir, exist_ok=True)
    os.makedirs(bg_dir, exist_ok=True)
    
    # Derivados
    dark_bg = adjust_lightness(background, -0.05)
    darker_bg = adjust_lightness(background, -0.08)
    lighter_bg = adjust_lightness(background, 0.05)
    
    dark_fg = adjust_lightness(foreground, -0.3)
    light_fg = adjust_lightness(foreground, 0.1)
    
    muted = adjust_lightness(accent, -0.4)
    selection = adjust_lightness(accent, -0.5)

    toml_content = f"""mode = "dark"
accent = "{accent}"
selection = "{selection}"
muted = "{muted}"
background = "{background}"
dark_background = "{dark_bg}"
darker_background = "{darker_bg}"
lighter_background = "{lighter_bg}"
foreground = "{foreground}"
dark_foreground = "{dark_fg}"
light_foreground = "{light_fg}"
bright_foreground = "{foreground}"
red = "#ff0000"
yellow = "#ffaa00"
orange = "#ff5500"
green = "#00ff55"
cyan = "#00ccff"
blue = "#0055ff"
magenta = "#ff00aa"
brown = "#5c2b2b"
bright_red = "#ff3333"
bright_yellow = "#ffcc33"
bright_green = "#33ff77"
bright_cyan = "#33ddff"
bright_blue = "#3377ff"
bright_magenta = "#ff33bb"
"""
    with open(os.path.join(theme_dir, "colors.toml"), "w") as f:
        f.write(toml_content)
        
    # Generate a dummy preview if it doesn't exist
    preview_path = os.path.join(theme_dir, "preview.png")
    if not os.path.exists(preview_path):
        os.system(f"magick -size 800x450 xc:'{background}' -fill '{accent}' -draw 'circle 400,225 400,300' {preview_path}")
        
    print(json.dumps({"status": "success", "message": f"Tema '{name}' guardado correctamente."}))

def read_theme(name):
    home = os.path.expanduser("~")
    # Puede estar en Temas o en system
    theme_dir = os.path.join(home, "Temas", name)
    if not os.path.exists(theme_dir):
        # Intentar en omarchy
        theme_dir = f"/usr/share/omarchy/themes/{name}"
        if not os.path.exists(theme_dir):
            print(json.dumps({"status": "error", "message": "Theme not found"}))
            return
            
    toml_path = os.path.join(theme_dir, "colors.toml")
    if not os.path.exists(toml_path):
        print(json.dumps({"status": "error", "message": "colors.toml not found"}))
        return
        
    data = {"accent": "#ffffff", "foreground": "#ffffff", "background": "#000000"}
    with open(toml_path, "r") as f:
        for line in f:
            if "=" in line:
                key, val = line.split("=", 1)
                key = key.strip()
                val = val.strip().strip('"').strip("'")
                if key in data:
                    data[key] = val
                    
    print(json.dumps({"status": "success", "data": data}))

def list_themes():
    home = os.path.expanduser("~")
    user_themes = os.path.join(home, "Temas")
    sys_themes = "/usr/share/omarchy/themes"
    
    themes = []
    if os.path.exists(user_themes):
        for d in os.listdir(user_themes):
            if os.path.isdir(os.path.join(user_themes, d)):
                themes.append(d)
                
    if os.path.exists(sys_themes):
        for d in os.listdir(sys_themes):
            if os.path.isdir(os.path.join(sys_themes, d)):
                if d not in themes:
                    themes.append(d)
                    
    print(json.dumps({"status": "success", "themes": sorted(themes)}))

if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit(1)
        
    cmd = sys.argv[1]
    if cmd == "save" and len(sys.argv) == 6:
        save_theme(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
    elif cmd == "read" and len(sys.argv) == 3:
        read_theme(sys.argv[2])
    elif cmd == "list":
        list_themes()
    else:
        print(json.dumps({"status": "error", "message": "Invalid arguments"}))

