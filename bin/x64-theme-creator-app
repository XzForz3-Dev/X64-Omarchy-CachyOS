#!/usr/bin/env python3
import sys
import os
import json
import subprocess
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gdk, GLib, Gio

def get_current_theme_colors():
    state_path = os.path.expanduser("~/.local/state/omarchy/current/theme")
    if os.path.islink(state_path):
        target = os.readlink(state_path)
    else:
        target = "/usr/share/omarchy/themes/monochrome"
    
    toml = os.path.join(target, "colors.toml")
    colors = {"background": "#101315", "foreground": "#cacccc", "accent": "#cacccc", "muted": "#707880"}
    if os.path.exists(toml):
        with open(toml) as f:
            for line in f:
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip('"').strip("'")
                    if k in colors:
                        colors[k] = v
    return colors

class ThemeCreatorApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="x64.theme.creator", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.script_path = os.path.join(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "bin", "x64-theme-creator-backend")
        self.colors = get_current_theme_colors()

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, title="X64 Theme Creator")
        win.set_default_size(450, 520)

        # Apply CSS for colors
        css_provider = Gtk.CssProvider()
        css = f"""
        window {{
            background-color: {self.colors['background']};
            color: {self.colors['foreground']};
        }}
        label {{
            color: {self.colors['foreground']};
        }}
        button {{
            background-color: {self.colors['background']};
            border: 1px solid {self.colors['muted']};
            color: {self.colors['foreground']};
        }}
        button.primary {{
            background-color: {self.colors['accent']};
            color: {self.colors['background']};
            font-weight: bold;
        }}
        entry {{
            background-color: #222;
            color: {self.colors['foreground']};
            border: 1px solid {self.colors['muted']};
        }}
        """
        css_provider.load_from_data(css.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=15)
        vbox.set_margin_top(20)
        vbox.set_margin_bottom(20)
        vbox.set_margin_start(20)
        vbox.set_margin_end(20)
        win.set_child(vbox)

        # Title
        title_label = Gtk.Label(label="<span size='large' weight='bold'>X64 Theme Creator</span>", use_markup=True)
        vbox.append(title_label)

        # Existing themes
        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row1.append(Gtk.Label(label="Temas Existentes:", xalign=0))
        self.theme_dropdown = Gtk.DropDown()
        row1.append(self.theme_dropdown)
        vbox.append(row1)

        # From Image
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row2.append(Gtk.Label(label="Desde Imagen:", xalign=0))
        self.img_input = Gtk.Entry(placeholder_text="Ruta de la imagen", hexpand=True)
        row2.append(self.img_input)
        
        btn_browse = Gtk.Button(label="📁")
        btn_browse.connect("clicked", self.on_browse)
        row2.append(btn_browse)
        
        btn_extract = Gtk.Button(label="Extraer")
        btn_extract.connect("clicked", self.on_extract)
        row2.append(btn_extract)
        vbox.append(row2)

        # Save As
        row3 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row3.append(Gtk.Label(label="Guardar Como:", xalign=0))
        self.name_input = Gtk.Entry(placeholder_text="Nombre de tu tema", hexpand=True)
        row3.append(self.name_input)
        vbox.append(row3)

        # Accent
        row4 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row4.append(Gtk.Label(label="Acento:", xalign=0))
        self.accent_input = Gtk.Entry(text="#00ccff", hexpand=True)
        row4.append(self.accent_input)
        vbox.append(row4)

        # Background
        row5 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row5.append(Gtk.Label(label="Fondo:", xalign=0))
        self.bg_input = Gtk.Entry(text="#0a0a0f", hexpand=True)
        row5.append(self.bg_input)
        vbox.append(row5)

        # Foreground
        row6 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row6.append(Gtk.Label(label="Texto (FG):", xalign=0))
        self.fg_input = Gtk.Entry(text="#e0e0e0", hexpand=True)
        row6.append(self.fg_input)
        vbox.append(row6)

        # Status
        self.status_label = Gtk.Label(label="Listo. Crea, edita o extrae desde imagen.")
        vbox.append(self.status_label)

        # Save Button
        btn_save = Gtk.Button(label="Guardar Tema")
        btn_save.add_css_class("primary")
        btn_save.connect("clicked", self.on_save)
        vbox.append(btn_save)

        # Load themes
        self.update_themes()
        
        self.theme_dropdown.connect("notify::selected", self.on_theme_selected)

        win.present()
        self.win = win

    def update_themes(self):
        try:
            res = subprocess.check_output(["python3", self.script_path, "list"], text=True)
            data = json.loads(res)
            if data.get("status") == "success":
                themes = data.get("themes", [])
                model = Gtk.StringList.new(themes)
                self.theme_dropdown.set_model(model)
        except Exception:
            pass

    def on_theme_selected(self, dropdown, param):
        item = dropdown.get_selected_item()
        if item:
            name = item.get_string()
            self.name_input.set_text(name)
            try:
                res = subprocess.check_output(["python3", self.script_path, "read", name], text=True)
                data = json.loads(res)
                if data.get("status") == "success":
                    d = data.get("data", {})
                    self.accent_input.set_text(d.get("accent", ""))
                    self.bg_input.set_text(d.get("background", ""))
                    self.fg_input.set_text(d.get("foreground", ""))
                    self.status_label.set_text("Tema cargado.")
            except Exception:
                pass

    def on_browse(self, btn):
        def on_response(dialog, response, user_data):
            if response == Gtk.ResponseType.ACCEPT:
                file = dialog.get_file()
                if file:
                    self.img_input.set_text(file.get_path())
                    self.on_extract(None)
            dialog.destroy()
            
        dialog = Gtk.FileChooserNative.new("Seleccionar imagen", self.win, Gtk.FileChooserAction.OPEN, "Abrir", "Cancelar")
        filter = Gtk.FileFilter()
        filter.set_name("Imágenes")
        filter.add_mime_type("image/png")
        filter.add_mime_type("image/jpeg")
        filter.add_mime_type("image/webp")
        dialog.add_filter(filter)
        dialog.connect("response", on_response, None)
        dialog.show()

    def on_extract(self, btn):
        path = self.img_input.get_text().strip()
        if not path:
            return
        try:
            res = subprocess.check_output(["python3", self.script_path, "extract", path], text=True)
            data = json.loads(res)
            if data.get("status") == "success":
                d = data.get("data", {})
                self.accent_input.set_text(d.get("accent", ""))
                self.bg_input.set_text(d.get("background", ""))
                self.fg_input.set_text(d.get("foreground", ""))
                self.status_label.set_text("Colores extraídos.")
            else:
                self.status_label.set_text("Error.")
        except Exception:
            self.status_label.set_text("Error de extracción.")

    def on_save(self, btn):
        name = self.name_input.get_text().strip()
        if not name:
            return
        try:
            res = subprocess.check_output(["python3", self.script_path, "save", name, self.accent_input.get_text(), self.fg_input.get_text(), self.bg_input.get_text()], text=True)
            data = json.loads(res)
            if data.get("status") == "success":
                self.status_label.set_text("Tema guardado.")
                self.update_themes()
            else:
                self.status_label.set_text("Error al guardar.")
        except Exception:
            self.status_label.set_text("Error.")

if __name__ == '__main__':
    app = ThemeCreatorApp()
    app.run(sys.argv)
