#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting an update

width=$(tput cols 2>/dev/null || echo 80)
box_width=70
box_margin=$(( (width - box_width) / 2 ))
[[ $box_margin -lt 0 ]] && box_margin=0

gum style \
  --width $box_width \
  --margin "1 0 1 $box_margin" \
  --border double \
  --border-foreground 198 \
  --padding "1 2" \
  --align center \
  "🚀 READY TO UPDATE X64 LIOS 🚀" \
  "" \
  "Únete a la evolución de tu sistema con las siguientes ventajas PRO:" \
  "" \
  "✨ Recibe las últimas actualizaciones de Omarchy." \
  "✨ Disfruta del máximo rendimiento con las" \
  "   últimas versiones Rolling Release de CachyOS." \
  "✨ Obtén las más recientes novedades de X64 LIOS" \
  "   junto con sus respectivos datos técnicos." \
  "" \
  "⚠️  No interrumpas el proceso una vez iniciado." \
  "⚡ Asegúrate de estar conectado a la corriente."

echo

# --- Centrado manual: pregunta ---
title="¿Iniciar Secuencia de Actualización?"
title_pad=$(( box_margin + (box_width - ${#title}) / 2 ))
[[ $title_pad -lt 0 ]] && title_pad=0
printf "%*s%s\n\n" $title_pad "" "$title"

# --- Centrado manual: botones ---
btn_si="    Sí    "
btn_no="    No    "
gap="  "
btn_line="${btn_si}${gap}${btn_no}"
btn_pad=$(( box_margin + (box_width - ${#btn_line}) / 2 ))
[[ $btn_pad -lt 0 ]] && btn_pad=0

# Renderizar los botones con colores
printf "%*s\033[48;5;198;38;5;232m%s\033[0m%s\033[48;5;237;38;5;254m%s\033[0m\n" \
  $btn_pad "" "$btn_si" "$gap" "$btn_no"
echo

# --- Centrado manual: input ---
prompt="(y) Sí  (n) No: "
prompt_pad=$(( box_margin + (box_width - ${#prompt}) / 2 ))
[[ $prompt_pad -lt 0 ]] && prompt_pad=0
printf "%*s%s" $prompt_pad "" "$prompt"

read -n 1 -r answer
echo

if [[ $answer == "y" || $answer == "Y" || $answer == "s" || $answer == "S" ]]; then
  exit 0
else
  echo
  msg="❌ Actualización cancelada por el usuario."
  msg_pad=$(( box_margin + (box_width - ${#msg}) / 2 ))
  [[ $msg_pad -lt 0 ]] && msg_pad=0
  printf "\033[31m%*s%s\033[0m\n" $msg_pad "" "$msg"
  exit 1
fi
