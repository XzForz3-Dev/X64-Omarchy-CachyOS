#!/bin/bash

width=$(tput cols || echo 80)
box_width=70
margin=$(( (width - box_width) / 2 ))
[[ $margin -lt 0 ]] && margin=0

gum style \
  --width $box_width \
  --margin "1 $margin" \
  --border double \
  --border-foreground 198 \
  --padding "1 2" \
  --align center \
  "🚀 READY TO UPDATE X64 LIOS 🚀" \
  "" \
  "Únete a la evolución de tu sistema con las siguientes ventajas PRO:" \
  "" \
  "✨ Recibe las últimas actualizaciones de Omarchy." \
  "✨ Disfruta del máximo rendimiento con las" \
  "   últimas versiones Rolling Release de CachyOS." \
  "✨ Obtén las más recientes novedades de X64 LIOS" \
  "   junto con sus respectivos datos técnicos." \
  "" \
  "⚠️ WARNING: No interrumpas el proceso una vez iniciado." \
  "⚡ Asegúrate de estar conectado a la corriente."

echo

# Centramos el texto de la pregunta usando gum style!
gum style --width $width --align center "¿Iniciar Secuencia de Actualización?"

# Centramos los botones
btn_yes="   YES   "
btn_no="   NO   "
# gum confirm añade 1 espacio entre los botones
btn_width=$(( ${#btn_yes} + 1 + ${#btn_no} ))
btn_margin=$(( (width - btn_width) / 2 ))
[[ $btn_margin -lt 0 ]] && btn_margin=0

if ! gum confirm "" --affirmative "$btn_yes" --negative "$btn_no" --selected.background 198 --selected.foreground 232 --unselected.background 237 --padding "0 $btn_margin"; then
  echo
  gum style --width $width --align center --foreground 196 " ❌ Update sequence aborted by user."
  exit 1
fi
