#!/usr/bin/env python3
# omarchy:summary=Mock GNOME Session Manager to handle logout events on pure TTY Wayland sessions
# omarchy:group=desktop
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib
import os
import sys

class SessionManager(dbus.service.Object):
    def __init__(self, bus, path):
        super().__init__(bus, path)

    @dbus.service.method("org.gnome.SessionManager", in_signature="u", out_signature="")
    def Logout(self, mode):
        print("Logout requested! Killing gnome-shell...")
        os.system("killall gnome-shell")

if __name__ == "__main__":
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    try:
        bus = dbus.SessionBus()
        # Intentar registrar el nombre. Si ya existe, simplemente salimos silenciosamente
        name = dbus.service.BusName("org.gnome.SessionManager", bus, do_not_queue=True)
        obj = SessionManager(bus, "/org/gnome/SessionManager")
        loop = GLib.MainLoop()
        loop.run()
    except Exception as e:
        sys.exit(0)
