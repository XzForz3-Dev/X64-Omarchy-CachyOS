#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

: "${OMARCHY_PATH:=/usr/share/omarchy}"

git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
git config --system --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

# FIX: omarchy-update corre como root (requires-sudo=true), pero el repo en
# /usr/share/omarchy pertenece al usuario. Git moderno bloquea operaciones
# en directorios ajenos. Si estamos corriendo como root y existe SUDO_USER,
# ejecutamos los comandos de git como el usuario real del sistema.
_git() {
  if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
    sudo -u "$SUDO_USER" git -C "$OMARCHY_PATH" "$@"
  else
    git -C "$OMARCHY_PATH" "$@"
  fi
}

echo -e "\e[32m\nUpdate Omarchy dev checkout\e[0m"
_git fetch --quiet || true
if ! _git merge --ff-only "@{upstream}"; then
  echo -e "\e[33m\nDetectados cambios locales en el sistema. Aplicando autostash para proteger la configuracion del usuario...\e[0m"
  _git pull --rebase --autostash
fi
