#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

: "${OMARCHY_PATH:=/usr/share/omarchy}"

git config --global --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true
git config --system --add safe.directory "$OMARCHY_PATH" 2>/dev/null || true

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

_git() {
  if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
    sudo -u "$SUDO_USER" git -C "$OMARCHY_PATH" "$@"
  else
    git -C "$OMARCHY_PATH" "$@"
  fi
}

echo -e "\e[32m\nUpdate Omarchy dev checkout\e[0m"

# i18n Auto-Sync: Para prevenir crasheos de Quickshell (hot-reload masivo),
# pausamos la interfaz gráfic si detectamos que hay traducciones aplicadas.
if ! _git diff --quiet; then
    echo ">> Pausando la interfaz gráfica temporalmente para la actualización segura..."
    if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
        sudo -u "$SUDO_USER" quickshell kill -p "$OMARCHY_PATH/shell" --any-display >/dev/null 2>&1 || true
    else
        quickshell kill -p "$OMARCHY_PATH/shell" --any-display >/dev/null 2>&1 || true
    fi
    sleep 0.5
fi

# i18n Auto-Sync: Limpiar cualquier traducción activa antes de actualizar el código
_git reset --hard HEAD || true

_git fetch --quiet || true
if ! _git merge --ff-only "@{upstream}"; then
  echo -e "\e[33m\nDetectados cambios locales en el sistema. Aplicando autostash para proteger la configuracion del usuario...\e[0m"
  _git pull --rebase --autostash
fi

# i18n Auto-Sync: Re-aplicar Español si el usuario lo tenía configurado previamente
REAL_HOME=$(eval echo "~${SUDO_USER:-$USER}")
if [[ -f "$REAL_HOME/.local/state/omarchy/lang_es_ES" ]]; then
    echo -e "\e[32m\nRe-aplicando idioma Español (Persistencia automática)...\e[0m"
    if (( EUID == 0 )) && [[ -n ${SUDO_USER:-} ]]; then
        sudo -u "$SUDO_USER" "$OMARCHY_PATH/bin/omarchy-language-set" es_ES --no-restart
    else
        "$OMARCHY_PATH/bin/omarchy-language-set" es_ES --no-restart
    fi
fi
